<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- mail.template is.reclamation -->
    <record id="is_mail_template_action" model="ir.actions.act_window">
        <field name="name">Modèles de courriels</field>
        <field name="res_model">mail.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('model_id.model','in',['account.move','purchase.order','sale.order'])]</field>
    </record>

    <menuitem 
        id="is_mail_template_menu" 
        sequence="900" 
        name="Modèles de courriels"
        parent="sale.menu_sale_config" 
        action="is_mail_template_action"
    />

    <!-- Menus non utilisés, réservés au groupe vide « Afficher les menus non utilisés » -->
    <record id="mail.menu_root_discuss" model="ir.ui.menu">
        <field name="group_ids" eval="[Command.set([ref('is_afficher_menus_non_utilises_group')])]"/>
    </record>
    <record id="spreadsheet_dashboard.spreadsheet_dashboard_menu_root" model="ir.ui.menu">
        <field name="group_ids" eval="[Command.set([ref('is_afficher_menus_non_utilises_group')])]"/>
    </record>
    <record id="utm.menu_link_tracker_root" model="ir.ui.menu">
        <field name="group_ids" eval="[Command.set([ref('is_afficher_menus_non_utilises_group')])]"/>
    </record>

</odoo>
