<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Migration v20 : la page de la facture v14 (remplacée en entier) est abandonnée au profit de la facture
         standard (mentions obligatoires françaises de l10n_fr_account, Factur-X), complétée ici avec les mêmes
         ajouts et les mêmes éléments masqués qu'en v14 -->
    <template id="is_report_invoice_document" name="is_report_invoice_document" inherit_id="account.report_invoice_document">
        <!-- Titre de la v14 : date de la facture après le numéro (colonne « Date de facturation » masquée) -->
        <xpath expr="//t[@t-set='layout_document_title']/span[@t-field='o.name']" position="after">
            <span t-if="o.invoice_date"> du <span t-field="o.invoice_date"/></span>
        </xpath>
        <xpath expr="//div[@name='invoice_date']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>

        <!-- Masqués en v14 : origine, code client, référence -->
        <xpath expr="//div[@name='origin']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//div[@name='customer_code']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//div[@name='reference']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>

        <!-- Informations de la v14 : date(s) d'intervention, mode de paiement, compte client -->
        <xpath expr="//div[@name='due_date']" position="before">
            <div class="col" t-if="o.is_type_facture=='atelier' and o.move_type == 'out_invoice'" name="is_date_intervention">
                <strong>Date(s) d'intervention(s)</strong>
                <div t-field="o.is_date_intervention"/>
            </div>
            <div class="col" t-if="o.invoice_payment_term_id and o.move_type == 'out_invoice'" name="is_mode_paiement">
                <strong>Mode de paiement</strong>
                <div t-field="o.invoice_payment_term_id.name"/>
            </div>
        </xpath>
        <xpath expr="//div[@name='due_date']" position="after">
            <div class="col" t-if="o.partner_id.property_account_receivable_id.code" name="is_compte_client">
                <strong>Compte client</strong>
                <div t-field="o.partner_id.property_account_receivable_id.code"/>
            </div>
        </xpath>

        <!-- Plaque d'immatriculation et kilométrage, sous les totaux -->
        <xpath expr="//div[@id='payment_term']" position="before">
            <div>
                <p t-if="o.is_plaque_immatriculation">
                    <strong>Plaque d'immatriculation : </strong><span t-field="o.is_plaque_immatriculation"/>
                </p>
                <p t-if="o.is_kilometrage">
                    <strong>Kilométrage : </strong><span t-field="o.is_kilometrage"/>
                </p>
            </div>
        </xpath>

        <!-- Masqués en v14 : note des conditions de paiement (nom affiché dans les informations), échéancier,
             communication de paiement, QR code -->
        <xpath expr="//span[@id='payment_terms_note_id']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//div[@id='total_payment_term_details_table']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//p[@name='payment_communication']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//t[@t-set='show_qr']" position="attributes">
            <attribute name="t-value">False</attribute>
        </xpath>

        <!-- Pénalités de retard et coordonnées bancaires -->
        <xpath expr="//div[@id='payment_term']" position="inside">
            <div style="font-size:70%">
                Escompte pour réglement anticipé : 0%<br />
                En cas de retard de paiement seront exigibles : une pénalité égale à 3 fois le taux d'intéret légal (décret 2009-138 du 9 février 2009),
                et une indemnité forfaitaire pour frais de recouvrement : 40 Euros (article 441-6 du Code du Commerce).
            </div>
            <br />
            <table style="width:60%">
                <tr>
                    <td>IBAN (International Bank Account Number)</td>
                    <td>BIC (Bank Identifier Code)</td>
                </tr>
                <tr>
                    <td>FR76 1009 6185 1200 0650 1330 229</td>
                    <td>CMCIFRPP</td>
                </tr>
            </table>
        </xpath>

        <!-- Conditions générales de vente, après la facture -->
        <xpath expr="//div[hasclass('invoice_main')]" position="after">
            <t t-call="is_acpl20.conditions_generales_de_vente" />
        </xpath>
    </template>
</odoo>
