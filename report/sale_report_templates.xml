<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Migration v20 : la page du devis v14 (remplacée en entier) est abandonnée au profit du devis standard,
         complété ici avec les mêmes ajouts et les mêmes éléments masqués qu'en v14 -->
    <template id="is_report_saleorder_document" name="is_report_saleorder_document" inherit_id="sale.report_saleorder_document">
        <!-- Titre de la v14 -->
        <xpath expr="//t[@t-set='layout_document_title']" position="replace">
            <t t-set="layout_document_title">
                <span t-if="is_proforma">Pro-Forma Invoice # </span>
                <span t-elif="doc.state in ['draft','sent']">Devis </span>
                <span t-else="">Commande </span>
                <span t-field="doc.name"/>
            </t>
        </xpath>

        <!-- Informations : masqués en v14 : expiration, incoterm, date de livraison, contact ; ajoutées : conditions
             de paiement -->
        <xpath expr="//div[@name='expiration_date']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//div[@t-if='doc.incoterm']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//div[@name='delivery_date']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//div[@t-if='doc.user_id.name']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//div[@id='informations']" position="inside">
            <div t-if="doc.payment_term_id" class="col" name="is_payment_term">
                <strong>Conditions de paiement</strong>
                <div t-field="doc.payment_term_id"/>
            </div>
        </xpath>

        <!-- Lieu d'intervention et mentions du devis, après les notes -->
        <xpath expr="//span[@name='order_note']/.." position="inside">
            <p t-if="doc.is_lieu_intervention">
                <strong>Lieu d'intervention : </strong><span t-field="doc.is_lieu_intervention"/>
            </p>
            <p>Devis gratuit valable 30 jours.</p>
            <p>Pour accepter ce devis, ajouter la mention 'Devis reçu avant l'éxécution des travaux, bon pour travaux', la date et votre signature.</p>
        </xpath>

        <!-- Conditions générales de vente, après le devis -->
        <xpath expr="//div[hasclass('page')]" position="after">
            <t t-call="is_acpl20.conditions_generales_de_vente"/>
        </xpath>
    </template>
</odoo>
